{
  "name": "dsp-rdp",
  "version": "0.2.5",
  "license": "MIT",
  "type": "module",
  "description": "Multi-machine RDP launcher for the dsh Web UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andarmworld/dsp-rdp.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "server",
    "cordis.patch.yml",
    "gateway/compose.yaml",
    "docs/images/panel-preview.png",
    "docs/images/panel-preview-mobile.png",
    "docs/npm-release.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "^18.2.25",
    "esbuild": "0.25.10",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "homepage": "https://github.com/andarmworld/dsp-rdp#readme",
  "bugs": {
    "url": "https://github.com/andarmworld/dsp-rdp/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "rdp",
    "remote-desktop",
    "guacamole"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
